# SMTP account used to send the shop order mails (copy to .env and fill in)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
# tls (STARTTLS, port 587) or ssl (port 465)
MAIL_SECURITY=tls
MAIL_USERNAME=
MAIL_PASSWORD=
# Sender address; most SMTP servers only accept the account's own address
MAIL_FROM=
MAIL_FROM_NAME="Kunstverein Heilbronn"
